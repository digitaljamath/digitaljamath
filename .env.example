# DigitalJamath Community Edition — Frappe / Docker

SITE_NAME=app.digitaljamath.com
ADMIN_PASSWORD=change-me-admin
MYSQL_ROOT_PASSWORD=digitaljamath_admin
DB_HOST=mariadb
DB_PORT=3306

# Optional: used by portal / Basira
OPENROUTER_API_KEY=
DEFAULT_FROM_EMAIL=salam@digitaljamath.com

# Cloud lead notifications (comma-separated). Confirm aliases in Cloudflare Email Routing.
# cloud_lead_recipients=salam@digitaljamath.com

# Cloud control plane
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
CLOUD_PROVISION_ENABLED=0
